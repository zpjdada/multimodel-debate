# Copy to .env and adjust the paths. Compose reads this file from the directory
# you run `docker compose` in; it is gitignored and never baked into the image.
#
# Absolute paths only: compose does not expand `~` inside volume paths.
# On Linux/macOS:   /home/you/.config/opencode
# On Windows:       C:/Users/you/.config/opencode
#
# Every command refuses to start while this is empty: an unset value would
# otherwise mount an empty directory and fail later with a provider error that
# does not name the real cause.

# The directory holding your opencode.json and provider credentials. Mounted
# read-only at /home/debate/.config/opencode. Nothing is copied into the image.
OPENCODE_CONFIG=

# Debian package mirror used at build time. Empty means deb.debian.org.
# Set it when the upstream mirror is slow or unreachable, e.g.
#   DEBIAN_MIRROR=mirrors.tuna.tsinghua.edu.cn
DEBIAN_MIRROR=
